{
  "$defs": {
    "CallMessage": {
      "description": "A message on an attempt's connection to its service, either way (DN29): calls by `id`,\nseveral in flight, each answered once.",
      "oneOf": [
        {
          "description": "From the plugin: a call.",
          "properties": {
            "args": {
              "default": null,
              "description": "Its arguments."
            },
            "id": {
              "description": "Its number, unique on the connection.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "method": {
              "description": "What is asked for.",
              "type": "string"
            },
            "type": {
              "const": "call",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "method"
          ],
          "type": "object"
        },
        {
          "description": "From the service: a call's result.",
          "properties": {
            "id": {
              "description": "The call's number.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "result": {
              "default": null,
              "description": "The result."
            },
            "type": {
              "const": "answer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "From the service: a call that failed.",
          "properties": {
            "id": {
              "description": "The call's number.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "message": {
              "description": "Why.",
              "type": "string"
            },
            "type": {
              "const": "call_failed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "ErrorSummary": {
      "description": "Why a task failed.",
      "properties": {
        "exception": {
          "description": "The error's type, e.g. `ExtensionError`.",
          "type": "string"
        },
        "message": {
          "description": "What went wrong.",
          "type": "string"
        },
        "traceback": {
          "description": "Where, if known.",
          "type": "string"
        }
      },
      "required": [
        "exception",
        "message",
        "traceback"
      ],
      "type": "object"
    },
    "ExtensionTask": {
      "additionalProperties": true,
      "description": "An `extension_task` request: what a plugin needs of it, the rest raw.",
      "properties": {
        "cleanup": {
          "description": "Set for a cleanup: the handles the attempt registered, in order.",
          "items": {
            "$ref": "#/$defs/Handle"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "dag_id": {
          "description": "The DAG's ID.",
          "type": "string"
        },
        "run": {
          "description": "The run's information (`run_id`, `try_number`, `planned_for`, ...)."
        },
        "secrets": {
          "default": [],
          "description": "The secrets the worker fetched for it.",
          "items": {
            "$ref": "#/$defs/SecretValue"
          },
          "type": "array"
        },
        "task": {
          "$ref": "#/$defs/Task",
          "description": "The task."
        }
      },
      "required": [
        "dag_id",
        "task",
        "run"
      ],
      "type": "object"
    },
    "Handle": {
      "description": "A cleanup handle.",
      "properties": {
        "handle_type": {
          "description": "Its type's name.",
          "type": "string"
        },
        "value": {
          "description": "Its value, JSON."
        }
      },
      "required": [
        "handle_type",
        "value"
      ],
      "type": "object"
    },
    "MetricPoint": {
      "description": "One point of a declared metric.",
      "properties": {
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Its labels' values.",
          "type": "object"
        },
        "name": {
          "description": "The declared metric.",
          "type": "string"
        },
        "value": {
          "description": "A counter's increase, a gauge's value, a histogram's observation.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "PluginMessage": {
      "description": "A message from the plugin to the worker.",
      "oneOf": [
        {
          "description": "The first message: in `extension` mode, naming the protocol.",
          "properties": {
            "metrics": {
              "description": "Its metrics' declarations, raw JSON (name, kind, help, unit, labels, buckets): the\nworker keeps them per extension and version, its config's winning.",
              "items": true,
              "type": "array"
            },
            "mode": {
              "description": "Always `extension`.",
              "type": "string"
            },
            "notifications": {
              "description": "Its notification events, raw JSON (name, help: M5.2i8).",
              "items": true,
              "type": "array"
            },
            "panels": {
              "description": "Its page's panels, raw JSON (title, metric, chart, row, cell; `point`, `combine`,\n`group_by`, `limit`: decision 516).",
              "items": true,
              "type": "array"
            },
            "protocol": {
              "description": "[`PROTOCOL`].",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "schedr_version": {
              "description": "The plugin's own version, not checked.",
              "type": "string"
            },
            "type": {
              "const": "hello",
              "type": "string"
            }
          },
          "required": [
            "type",
            "schedr_version",
            "mode",
            "protocol"
          ],
          "type": "object"
        },
        {
          "description": "A secret the task declared; answered [`WorkerMessage::Secret`] or\n[`WorkerMessage::SecretFailed`].",
          "properties": {
            "secret": {
              "$ref": "#/$defs/SecretName",
              "description": "Which secret."
            },
            "type": {
              "const": "secret_get",
              "type": "string"
            }
          },
          "required": [
            "type",
            "secret"
          ],
          "type": "object"
        },
        {
          "description": "A connection the task declared; answered [`WorkerMessage::Connection`] or\n[`WorkerMessage::ConnectionFailed`].",
          "properties": {
            "name": {
              "description": "The connection's name.",
              "type": "string"
            },
            "type": {
              "const": "connection_get",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "A cleanup handle; answered [`WorkerMessage::HandleAdded`] or\n[`WorkerMessage::HandleRefused`].",
          "properties": {
            "handle": {
              "$ref": "#/$defs/Handle",
              "description": "The handle."
            },
            "type": {
              "const": "handle_add",
              "type": "string"
            }
          },
          "required": [
            "type",
            "handle"
          ],
          "type": "object"
        },
        {
          "description": "A call to schedr's REST API, made by the master as the task; answered\n[`WorkerMessage::ApiAnswer`].",
          "properties": {
            "body": {
              "description": "The JSON body, if any."
            },
            "idempotency_key": {
              "description": "Its `Idempotency-Key`, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "description": "`GET`, `POST`, ...",
              "type": "string"
            },
            "path": {
              "description": "The path and its query.",
              "type": "string"
            },
            "type": {
              "const": "api_call",
              "type": "string"
            }
          },
          "required": [
            "type",
            "method",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "The task (or cleanup) succeeded with this output.",
          "properties": {
            "outcome": {
              "description": "`SUCCESS`.",
              "type": "string"
            },
            "output": {
              "description": "The output, JSON."
            },
            "type": {
              "const": "task_succeeded",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output",
            "outcome"
          ],
          "type": "object"
        },
        {
          "description": "Where the task is now (decision 513): kept with the attempt, with its time. No answer.",
          "properties": {
            "message": {
              "description": "More about it.",
              "type": [
                "string",
                "null"
              ]
            },
            "phase": {
              "description": "A short name for the phase, e.g. `pulling image`.",
              "type": "string"
            },
            "progress": {
              "description": "How far along, 0 to 1, when known.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "type": {
              "const": "status",
              "type": "string"
            }
          },
          "required": [
            "type",
            "phase"
          ],
          "type": "object"
        },
        {
          "description": "A link to what the task started elsewhere; a second with the same label replaces it.\nOnly `http` and `https` URLs are kept. No answer.",
          "properties": {
            "label": {
              "description": "What it links to.",
              "type": "string"
            },
            "type": {
              "const": "link",
              "type": "string"
            },
            "url": {
              "description": "Its URL.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "label",
            "url"
          ],
          "type": "object"
        },
        {
          "description": "Why the task is being stopped, asked after SIGTERM; answered\n[`WorkerMessage::StopReason`]. The worker never sends an unasked message.",
          "properties": {
            "type": {
              "const": "stop_reason_get",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Points of the extension's declared metrics. No answer: one matching no declaration is\ndropped by the worker with a warning.",
          "properties": {
            "points": {
              "description": "The points.",
              "items": {
                "$ref": "#/$defs/MetricPoint"
              },
              "type": "array"
            },
            "type": {
              "const": "metrics",
              "type": "string"
            }
          },
          "required": [
            "type",
            "points"
          ],
          "type": "object"
        },
        {
          "description": "One of its declared notification events (M5.2i8), told to the channels of the attempt's\nDAG subscribed to `EXTENSION_EVENT`. No answer: an undeclared one is dropped by the\nworker with a warning.",
          "properties": {
            "data": {
              "description": "More about it, JSON."
            },
            "event": {
              "description": "The declared event's name.",
              "type": "string"
            },
            "text": {
              "description": "What happened, one line; none: schedr's summary.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "notify",
              "type": "string"
            }
          },
          "required": [
            "type",
            "event"
          ],
          "type": "object"
        },
        {
          "description": "The task (or cleanup) failed.",
          "properties": {
            "error": {
              "$ref": "#/$defs/ErrorSummary",
              "description": "What went wrong."
            },
            "kind": {
              "description": "A failure schedr recognises (`output_too_large`); `None` for the plugin's own.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "task_failed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "error"
          ],
          "type": "object"
        }
      ]
    },
    "SecretName": {
      "description": "A secret's name.",
      "properties": {
        "key": {
          "description": "The key; `None` for the whole secret.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The path.",
          "type": "string"
        },
        "storage": {
          "description": "The storage; `None` for the default.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "SecretValue": {
      "description": "A secret the worker fetched for the attempt.",
      "properties": {
        "name": {
          "$ref": "#/$defs/SecretName",
          "description": "Which."
        },
        "value": {
          "description": "Its value."
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "ServiceMessage": {
      "description": "A message from an extension's service to its worker, on its control socket\n(`SCHEDR_SERVICE_FD`, decision 518).",
      "oneOf": [
        {
          "description": "The first message, naming the extension and the versions it serves.",
          "properties": {
            "mode": {
              "description": "Always `service`.",
              "type": "string"
            },
            "name": {
              "description": "The extension.",
              "type": "string"
            },
            "protocol": {
              "description": "[`SERVICE_PROTOCOL`].",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "schedr_version": {
              "description": "The service's own version, not checked.",
              "type": "string"
            },
            "type": {
              "const": "hello",
              "type": "string"
            },
            "versions": {
              "description": "The versions of it the service serves; the worker offers only those of its\nconfigured ones.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "schedr_version",
            "mode",
            "protocol",
            "name",
            "versions"
          ],
          "type": "object"
        },
        {
          "description": "Started and serving, after the welcome: attempts may connect from now on.",
          "properties": {
            "type": {
              "const": "ready",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The answer to [`ToService::AttemptConnected`]: the attempt's connection taken, its plugin\nmay start. Unanswered within `service_accept_timeout`, the attempt fails, and a few in a\nrow take the service for hung (DN32).",
          "properties": {
            "attempt_id": {
              "description": "The attempt.",
              "type": "string"
            },
            "type": {
              "const": "attempt_accepted",
              "type": "string"
            }
          },
          "required": [
            "type",
            "attempt_id"
          ],
          "type": "object"
        },
        {
          "description": "One of its declared secrets, again (`service_secrets`); answered [`ToService::ServiceSecret`] or\n[`ToService::ServiceSecretFailed`].",
          "properties": {
            "secret": {
              "$ref": "#/$defs/SecretName",
              "description": "Which secret."
            },
            "type": {
              "const": "secret_get",
              "type": "string"
            }
          },
          "required": [
            "type",
            "secret"
          ],
          "type": "object"
        },
        {
          "description": "What it is doing, for people (an event when it changes).",
          "properties": {
            "message": {
              "description": "More about it.",
              "type": [
                "string",
                "null"
              ]
            },
            "phase": {
              "description": "A short name for the phase, e.g. `watching`.",
              "type": "string"
            },
            "type": {
              "const": "status",
              "type": "string"
            }
          },
          "required": [
            "type",
            "phase"
          ],
          "type": "object"
        },
        {
          "description": "Points of its extension's declared metrics, as a plugin's.",
          "properties": {
            "points": {
              "description": "The points.",
              "items": {
                "$ref": "#/$defs/MetricPoint"
              },
              "type": "array"
            },
            "type": {
              "const": "metrics",
              "type": "string"
            }
          },
          "required": [
            "type",
            "points"
          ],
          "type": "object"
        }
      ]
    },
    "ServiceTask": {
      "description": "The task an attempt connected to a service runs.",
      "properties": {
        "name": {
          "description": "The extension.",
          "type": "string"
        },
        "version": {
          "description": "The exact version the task is written for.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "Settings": {
      "additionalProperties": true,
      "description": "A task's settings.",
      "properties": {
        "max_output_size": {
          "description": "The most its output may take, in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_output_size"
      ],
      "type": "object"
    },
    "StopKind": {
      "description": "Why the worker stops a plugin.",
      "oneOf": [
        {
          "const": "cancel",
          "description": "A user cancelled the task.",
          "type": "string"
        },
        {
          "const": "timeout",
          "description": "The task's timeout passed.",
          "type": "string"
        },
        {
          "const": "drain",
          "description": "The worker drains: the task is retried elsewhere.",
          "type": "string"
        },
        {
          "const": "master_lost",
          "description": "The worker lost the master: the task may run, or be cleaned up, elsewhere.",
          "type": "string"
        }
      ]
    },
    "Task": {
      "additionalProperties": true,
      "description": "The task of an [`ExtensionTask`]: its kind `extension`.",
      "properties": {
        "id": {
          "description": "The task's ID.",
          "type": "string"
        },
        "kind": {
          "description": "`extension`.",
          "type": "string"
        },
        "name": {
          "description": "The extension's name.",
          "type": "string"
        },
        "payload": {
          "default": null,
          "description": "What it asks the plugin to do."
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "description": "Its settings: `max_output_size` read here, the rest raw."
        },
        "version": {
          "description": "The version it is written for.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "version",
        "settings"
      ],
      "type": "object"
    },
    "ToService": {
      "description": "A message from the worker to an extension's service, on its control socket.",
      "oneOf": [
        {
          "description": "The answer to its hello: go on, with its declared secrets, read for this start.",
          "properties": {
            "secrets": {
              "default": [],
              "description": "The secrets of `service_secrets`.",
              "items": {
                "$ref": "#/$defs/SecretValue"
              },
              "type": "array"
            },
            "type": {
              "const": "welcome",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The answer to its hello: it can't run here (another protocol, another extension); it\nexits.",
          "properties": {
            "reason": {
              "description": "Why.",
              "type": "string"
            },
            "type": {
              "const": "refused",
              "type": "string"
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "An attempt's private connection: the descriptor of its end of a socket pair comes with\nthis message (`SCM_RIGHTS`, on its first byte). The other end is the attempt's plugin's\n`SCHEDR_SERVICE_FD`; its closing is the attempt's end.",
          "properties": {
            "attempt_id": {
              "description": "The attempt.",
              "type": "string"
            },
            "task": {
              "$ref": "#/$defs/ServiceTask",
              "description": "The task it runs."
            },
            "type": {
              "const": "attempt_connected",
              "type": "string"
            }
          },
          "required": [
            "type",
            "attempt_id",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "The worker drained for maintenance (`schedr workers drain`, DN33): it gets no attempts\nmeanwhile; a service that acts on its own pauses itself. It keeps running.",
          "properties": {
            "type": {
              "const": "drained",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The worker resumed after [`Self::Drained`]: attempts come again.",
          "properties": {
            "type": {
              "const": "resumed",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The secret asked for.",
          "properties": {
            "type": {
              "const": "secret",
              "type": "string"
            },
            "value": {
              "description": "A key's value, or a whole secret's object."
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "The secret asked for can't be given.",
          "properties": {
            "kind": {
              "description": "`secret_denied` (not declared), `secret_not_found`, `secret_unavailable`.",
              "type": "string"
            },
            "message": {
              "description": "Why.",
              "type": "string"
            },
            "type": {
              "const": "secret_failed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "WorkerMessage": {
      "description": "A message from the worker to the plugin.",
      "oneOf": [
        {
          "description": "The handshake succeeded.",
          "properties": {
            "type": {
              "const": "welcome",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The handshake failed; the plugin exits.",
          "properties": {
            "reason": {
              "description": "Why.",
              "type": "string"
            },
            "type": {
              "const": "refused",
              "type": "string"
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ExtensionTask",
          "description": "The attempt: the task, or its cleanup (`cleanup` set).",
          "properties": {
            "type": {
              "const": "extension_task",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A secret's value.",
          "properties": {
            "type": {
              "const": "secret",
              "type": "string"
            },
            "value": {
              "description": "A key's value, or a whole secret's object."
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "Why a secret can't be read.",
          "properties": {
            "kind": {
              "description": "`secret_unavailable`, `secret_denied`, `secret_not_found`.",
              "type": "string"
            },
            "message": {
              "description": "What went wrong.",
              "type": "string"
            },
            "type": {
              "const": "secret_failed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "A connection's values.",
          "properties": {
            "type": {
