class Options(argparse.Namespace):
    """Its options, typed."""

    service: bool = False
    namespace: str = "default"
    context: str | None = None
    kubeconfig: str | None = None
    headlamp: str | None = None
    dashboard: str | None = None
    headlamp_cluster: str = "main"


def parsed(argv: list[str]) -> Options:
    """Its options."""
    parser = argparse.ArgumentParser(prog="schedr-ext-kubernetes")
    parser.add_argument("--service", action="store_true", help="run as the extension's service")
    parser.add_argument("--namespace", default="default")
    parser.add_argument("--context")
    parser.add_argument("--kubeconfig")
    where = parser.add_mutually_exclusive_group()
    where.add_argument("--headlamp", help="Headlamp's address, for links to Jobs and pods")
    where.add_argument("--dashboard", help="the Kubernetes Dashboard's address, for links")
    parser.add_argument("--headlamp-cluster", default="main", help="the cluster's name in Headlamp")
    return parser.parse_args(argv, namespace=Options())


def ui_of(options: Options) -> Ui | None:
    """The UI its links go to, if one is given."""
    if options.headlamp is not None:
        return Ui("headlamp", options.headlamp, options.headlamp_cluster)
    if options.dashboard is not None:
        return Ui("dashboard", options.dashboard)
    return None


def entry(argv: list[str], cluster: Cluster | None = None) -> int:
    """The service (`--service`) or the plugin, of its options.

    `--describe` alone is the plugin helper's; `cluster` stands in for the real one in tests.
    """
    if argv == ["--describe"]:
        options, argv = Options(), ["--describe"]
    else:
        options, argv = parsed(argv), []
    if options.service:
        kube = cluster or KubeCluster(options.namespace, options.context, options.kubeconfig)
        service = KubernetesService(kube)
        return serve(
            service.on_call,
            name="kubernetes",
            versions=["1.0"],
            start=service.start,
            stop=service.stop,
            on_closed=service.on_closed,
        )
    return main(
        make_run(options.namespace, ui_of(options)),
        name="kubernetes",
        versions=["1.0"],
        cleanup=cleanup,
        metrics=METRICS,
        panels=PANELS,
        notifications=NOTIFICATIONS,
        argv=argv,
    )


if __name__ == "__main__":
    with contextlib.suppress(KeyboardInterrupt):
        raise SystemExit(entry(sys.argv[1:]))
