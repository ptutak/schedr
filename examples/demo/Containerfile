# The connections demo's image (`make demo`): the schedr base image (which has the client
# tools and libraries the demo's commands and tasks use) and the demo's start scripts. `make
# demo` builds it; by hand, after `make image`, from the repository root:
#   podman build --build-arg SCHEDR=schedr:0.1.0 -t schedr-demo examples/demo
ARG SCHEDR=schedr:0.1.0
FROM ${SCHEDR}
COPY keys.sh /usr/local/bin/schedr-demo-keys
COPY start.sh /usr/local/bin/schedr-demo-start
