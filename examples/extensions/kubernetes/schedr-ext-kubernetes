OUTPUT_PREFIX = "SCHEDR_OUTPUT: "
# The pod never starts with these: the attempt fails at once instead of waiting for its timeout.
STUCK = {"ErrImagePull", "ImagePullBackOff", "InvalidImageName", "CreateContainerConfigError"}
MANAGED = "app.kubernetes.io/managed-by"
MANAGED_SELECTOR = f"{MANAGED}=schedr"
# A log call's most bytes, and how long it waits for some before answering with none.
LOG_CHUNK = 65536
LOG_WAIT = 1.0
# The most chunks of a pod's log held for its plugin: the log is followed no faster.
LOG_HELD = 64
NOT_FOUND = 404
# A watch's server-side end, and the client's own limit beyond it: a connection gone silent (a
# half-open one) is given up instead of waited on for ever.
WATCH_SECONDS = 300
WATCH_CLIENT_SECONDS = WATCH_SECONDS + 30
# How long a failed Job waits for its pod's reason before it is told without one: the Jobs and
# the pods are two watches, either may come first.
FAILURE_DETAIL_SECONDS = 5.0
# The most of a pod's last line read for its output, whatever a task's `max_output_size` says.
MAX_OUTPUT_READ = 16 * 1024 * 1024
# The most deleted Jobs remembered (a call about one ends at once).
REMEMBERED = 1000

log = logging.getLogger("schedr-ext-kubernetes")


def obj(value: object) -> dict[str, ExtensionJson]:
    """`value` if a JSON object, else an empty one: what the API sent, read defensively."""
    return cast("dict[str, ExtensionJson]", value) if isinstance(value, dict) else {}


def items(value: object) -> list[ExtensionJson]:
    """`value` if a JSON array, else an empty one."""
    return cast("list[ExtensionJson]", value) if isinstance(value, list) else []


def decoded(text: str) -> ExtensionJson:
    """`text` read as JSON."""
    # `json.loads` gives decoded JSON: nothing but these types.
    return cast("ExtensionJson", json.loads(text))


class PodFailedError(Exception):
    """The Job's pod failed: its reason and exit code; or it will never start."""

    def __init__(self, message: str, waiting: str | None = None) -> None:
        """Of what happened; `waiting`: the reason a pod that will never start waits for."""
        super().__init__(message)
        self.waiting: str | None = waiting


def job_name(request: ExtensionRequest) -> str:
    """The attempt's Job: its task's ID and a hash of its DAG, run and try, DNS-safe."""
    attempt = f"{request.dag_id}/{request.task_id}/{request.run.get('run_id')}"
    digest = hashlib.sha256(f"{attempt}/{request.run.get('try_number')}".encode()).hexdigest()
    slug = re.sub(r"[^a-z0-9-]+", "-", request.task_id.lower()).strip("-")[:30] or "task"
    return f"schedr-{slug}-{digest[:12]}"


def checked(payload: ExtensionJson) -> dict[str, ExtensionJson]:
    """The payload, its fields' types checked before anything is created.

    A mistyped field fails the attempt instead of being dropped: a string `command` would run
    the image's own.
    """
    fields = obj(payload)
    if not isinstance(payload, dict) or not isinstance(fields.get("image"), str):
        raise ValueError('the payload is an object with an "image", a string')
    if "command" in fields:
        command = fields["command"]
        if not isinstance(command, list) or not all(isinstance(c, str) for c in command):
            raise ValueError('"command" is a list of strings')
    for key in ("env", "secret_env", "resources", "node_selector"):
        if key in fields and not isinstance(fields[key], dict):
            raise ValueError(f'"{key}" is an object')
    for key in ("env", "secret_env", "node_selector"):
        if not all(isinstance(v, str) for v in obj(fields.get(key)).values()):
            raise ValueError(f'"{key}"\'s values are strings')
    unknown = set(fields) - {"image", "command", "env", "secret_env", "resources", "node_selector"}
    if unknown:
        raise ValueError(f"unknown payload fields: {sorted(unknown)}")
    return fields


def secret_name(job: str) -> str:
    """The Secret holding a Job's secret variables."""
    return f"{job}-env"


def manifest(
    name: str, payload: Mapping[str, ExtensionJson], secret_vars: list[str]
) -> dict[str, ExtensionJson]:
    """The Job: one pod, never restarted, never retried (schedr retries).

    Its secret variables are read from its Secret, never written in the Job.
    """
    env: list[ExtensionJson] = []
    for key, value in obj(payload.get("env")).items():
        plain: dict[str, ExtensionJson] = {"name": key, "value": str(value)}
        env.append(plain)
    for var in secret_vars:
        ref: dict[str, ExtensionJson] = {"name": secret_name(name), "key": var}
        from_secret: dict[str, ExtensionJson] = {"name": var, "valueFrom": {"secretKeyRef": ref}}
        env.append(from_secret)
    container: dict[str, ExtensionJson] = {
        "name": "task",
        "image": payload["image"],
        "env": env,
    }
    if "command" in payload:
        container["command"] = [str(part) for part in items(payload["command"])]
    if "resources" in payload:
        container["resources"] = payload["resources"]
    pod: dict[str, ExtensionJson] = {
        "restartPolicy": "Never",
        # No API token in the pod: a task's image gets only what the task declared.
        "automountServiceAccountToken": False,
        "containers": [container],
    }
    if "node_selector" in payload:
        pod["nodeSelector"] = payload["node_selector"]
    labels: dict[str, ExtensionJson] = {MANAGED: "schedr"}
    return {
        "apiVersion": "batch/v1",
        "kind": "Job",
        "metadata": {"name": name, "labels": labels},
        "spec": {
            "backoffLimit": 0,
            # Its pod labelled too: the service watches schedr's pods by it.
            "template": {"metadata": {"labels": dict(labels)}, "spec": pod},
        },
    }


# ---------------------------------------------------------------- the cluster


class Cluster(Protocol):
    """What the service asks of Kubernetes, in one namespace (a handle's may be another)."""

    namespace: str

    async def open(self) -> None:
        """Connects."""
        ...

    async def close(self) -> None:
        """Disconnects."""
        ...

    async def create_secret(self, name: str, values: Mapping[str, str]) -> None:
        """Creates a Secret of `values`."""
        ...

    async def create_job(self, manifest: Mapping[str, ExtensionJson]) -> str:
        """Creates a Job; its UID."""
        ...

    async def own_secret(self, name: str, job: str, job_uid: str) -> None:
        """Makes Secret `name` the Job's: deleted with it."""
        ...

    async def delete_job(self, name: str, namespace: str) -> None:
        """Deletes a Job and its pods; none there is no error."""
        ...

    async def delete_secret(self, name: str, namespace: str) -> None:
        """Deletes a Secret; none there is no error."""
        ...

    def watch(self, kind: str) -> AsyncIterator[tuple[str, dict[str, ExtensionJson]]]:
        """Schedr's `pods` or `jobs` in the namespace as they change.

        First `SYNC` (`{"items": [...]}`: all of them now), then `ADDED`, `MODIFIED`, `DELETED`;
        a watch that breaks lists them again (`SYNC`) and goes on from there.
        """
        ...

    def follow_logs(self, pod: str) -> AsyncIterator[bytes]:
        """A pod's log as it comes, to its end."""
        ...

    async def last_line(self, pod: str, limit: int) -> str:
        """An ended pod's last log line, at most `limit` bytes read of it."""
        ...


class KubeCluster:
    """The cluster through `kubernetes_asyncio`."""

    def __init__(self, namespace: str, context: str | None, kubeconfig: str | None) -> None:
        """Of these options; connected by `open`."""
        self.namespace: str = namespace
        self.context: str | None = context
        self.kubeconfig: str | None = kubeconfig
        # Made by `open`, in the event loop: the client's sessions need one.
        self.clients: tuple[client.ApiClient, client.CoreV1Api, client.BatchV1Api] | None = None

    @property
    def api(self) -> client.ApiClient:
        """The API client; opened first."""
        return self.opened()[0]

    @property
    def core(self) -> client.CoreV1Api:
        """The core API (pods, logs, Secrets)."""
        return self.opened()[1]

    @property
    def batch(self) -> client.BatchV1Api:
        """The batch API (Jobs)."""
        return self.opened()[2]

    def opened(self) -> tuple[client.ApiClient, client.CoreV1Api, client.BatchV1Api]:
        """Its clients, made by `open`."""
        if self.clients is None:
            raise RuntimeError("the cluster isn't opened")
        return self.clients

    async def open(self) -> None:
        """Its kubeconfig (or the pod's service account in a cluster)."""
        # The library's loaders aren't fully typed; they return nothing used here.
        # In a pod with neither option, its service account; else the kubeconfig, its errors
        # told as they are (agy's review: a wrong --kubeconfig fell back to the pod's own).
        given = self.kubeconfig is not None or self.context is not None
        if not given and os.environ.get("KUBERNETES_SERVICE_HOST"):
            config.load_incluster_config()  # type: ignore[no-untyped-call]  # pyright: ignore[reportUnknownMemberType]
        else:
            if self.kubeconfig is not None and not os.path.isfile(self.kubeconfig):
                # The library's own message ("Expected key current-context") names no file.
                raise FileNotFoundError(f"no kubeconfig at {self.kubeconfig}")
            await config.load_kube_config(  # pyright: ignore[reportUnknownMemberType]
                config_file=self.kubeconfig, context=self.context
            )
        api = client.ApiClient()
        self.clients = (api, client.CoreV1Api(api), client.BatchV1Api(api))

    async def close(self) -> None:
        """Closes its connections."""
        if self.clients is not None:
            await self.clients[0].close()

    def plain(self, value: object) -> dict[str, ExtensionJson]:
        """An API object as the JSON the API sent (camelCase keys)."""
        # Untyped in the library: plain JSON, read through `obj`.
        return obj(cast("object", self.api.sanitize_for_serialization(value)))

    async def create_secret(self, name: str, values: Mapping[str, str]) -> None:
        """Creates a Secret of `values`."""
        body = client.V1Secret(
            metadata=client.V1ObjectMeta(name=name, labels={MANAGED: "schedr"}),
            string_data=dict(values),
        )
        await self.core.create_namespaced_secret(self.namespace, body)

    async def create_job(self, manifest: Mapping[str, ExtensionJson]) -> str:
        """Creates a Job; its UID."""
        # The client sends a dict as it is: the manifest is the Job's JSON.
        body = cast("client.V1Job", cast("object", dict(manifest)))
        created = await self.batch.create_namespaced_job(self.namespace, body)
        return str(obj(self.plain(created).get("metadata")).get("uid", ""))

    async def own_secret(self, name: str, job: str, job_uid: str) -> None:
        """Makes Secret `name` the Job's: deleted with it."""
        owner = {"apiVersion": "batch/v1", "kind": "Job", "name": job, "uid": job_uid}
        patch = {"metadata": {"ownerReferences": [owner]}}
        await self.core.patch_namespaced_secret(name, self.namespace, patch)

    async def delete_job(self, name: str, namespace: str) -> None:
        """Deletes a Job and its pods; none there is no error."""
        try:
            await self.batch.delete_namespaced_job(name, namespace, propagation_policy="Background")
        except ApiException as e:
            if e.status != NOT_FOUND:
                raise

    async def delete_secret(self, name: str, namespace: str) -> None:
        """Deletes a Secret; none there is no error."""
        try:
            await self.core.delete_namespaced_secret(name, namespace)
        except ApiException as e:
            if e.status != NOT_FOUND:
                raise

    async def watch(self, kind: str) -> AsyncIterator[tuple[str, dict[str, ExtensionJson]]]:
        """Schedr's `pods` or `jobs`, as `Cluster.watch` says.

        Listed, then watched from the list's version, so a restarted watch replaces what it held
        at once (agy's review: cleared first, the gauges dropped to nothing at every restart).
        """
        lister = self.core.list_namespaced_pod if kind == "pods" else self.batch.list_namespaced_job
        while True:
            try:
                listed = self.plain(await lister(self.namespace, label_selector=MANAGED_SELECTOR))
                version = str(obj(listed.get("metadata")).get("resourceVersion", ""))
                yield "SYNC", {"items": items(listed.get("items"))}
                watcher = watch.Watch()
                try:
                    # Untyped in the library: each event a dict, read through `obj`.
                    events = cast(
                        "AsyncIterator[object]",
                        watcher.stream(  # pyright: ignore[reportUnknownMemberType]
                            lister,
                            self.namespace,
                            label_selector=MANAGED_SELECTOR,
                            resource_version=version,
                            timeout_seconds=WATCH_SECONDS,
                            _request_timeout=WATCH_CLIENT_SECONDS,
                        ),
                    )
                    async for event in events:
                        happened = obj(event)
                        kind_of = str(happened.get("type", ""))
                        if kind_of == "ERROR":  # its version too old: listed again
                            break
                        yield kind_of, self.plain(happened.get("object"))
                finally:
                    await watcher.close()
            except asyncio.CancelledError:
                raise
            except Exception as e:  # a broken watch is started again
                log.warning("the %s watch broke: %s; again in a second", kind, e)
                await asyncio.sleep(1)

    async def follow_logs(self, pod: str) -> AsyncIterator[bytes]:
        """A pod's log as it comes, to its end."""
        # Not read in: the client hands the response itself back.
        raw = await self.core.read_namespaced_pod_log(
            pod, self.namespace, follow=True, _preload_content=False
        )
        response = cast("aiohttp.ClientResponse", cast("object", raw))
        async with response:
            # Not raised by the client unread (agy's review): a refused log is an error.
            if not 200 <= response.status < 300:  # noqa: PLR2004 (HTTP's success range)
                body = (await response.text())[:500]
                raise RuntimeError(f"the pod's log: HTTP {response.status}: {body}")
            while chunk := await response.content.read(LOG_CHUNK):
                yield chunk

    async def last_line(self, pod: str, limit: int) -> str:
        """An ended pod's last log line, at most `limit` bytes read of it."""
        text = await self.core.read_namespaced_pod_log(
            pod, self.namespace, tail_lines=1, limit_bytes=limit
        )
        return str(text).rstrip("\n")


# ---------------------------------------------------------------- the service


class Watched:
    """schedr's objects of one kind as the watch last said, by name, and their changes."""

    def __init__(self) -> None:
        """Empty until the watch says."""
        self.objects: dict[str, dict[str, ExtensionJson]] = {}
        # Those deleted lately: a call about one ends at once (agy's review: it waited for ever).
        self.deleted: OrderedDict[str, None] = OrderedDict()
        self.changed: asyncio.Condition = asyncio.Condition()
        self.version: int = 0

    def gone(self, name: str) -> None:
        """`name` deleted: remembered, the oldest forgotten past `REMEMBERED`."""
        self.deleted[name] = None
        self.deleted.move_to_end(name)
        while len(self.deleted) > REMEMBERED:
            self.deleted.popitem(last=False)

    async def follow(self, events: AsyncIterator[tuple[str, dict[str, ExtensionJson]]]) -> None:
        """Keeps up with `events`."""
        async for kind, value in events:
            async with self.changed:
                if kind == "SYNC":
                    listed = [obj(item) for item in items(value.get("items"))]
                    now = {str(obj(item.get("metadata")).get("name", "")): item for item in listed}
                    for name in self.objects.keys() - now.keys():
                        self.gone(name)
                    self.objects = now
                else:
                    name = str(obj(value.get("metadata")).get("name", ""))
                    if kind == "DELETED":
                        self.objects.pop(name, None)
                        self.gone(name)
                    elif name:
                        self.objects[name] = value
                        self.deleted.pop(name, None)
                self.version += 1
                self.changed.notify_all()


def stuck(pod: Mapping[str, ExtensionJson]) -> None:
    """Raises `PodFailedError` for a pod that will never start (its image can't be pulled)."""
    for container in items(obj(pod.get("status")).get("containerStatuses")):
        waiting = obj(obj(obj(container).get("state")).get("waiting"))
        if waiting.get("reason") in STUCK:
            reason = str(waiting["reason"])
            raise PodFailedError(f"{reason}: {waiting.get('message', '')}", waiting=reason)


def job_pods(
    pods: Mapping[str, dict[str, ExtensionJson]], job: str
) -> list[dict[str, ExtensionJson]]:
    """The pods of Job `job`."""
    return [
        pod
        for pod in pods.values()
        if obj(obj(pod.get("metadata")).get("labels")).get("job-name") == job
    ]


def failure(failed: PodFailedError) -> dict[str, ExtensionJson]:
    """A failure as a call's answer: its plugin tells its event from `waiting`."""
    return {"failed": str(failed), "waiting": failed.waiting}


class LogTail:
    """A pod's log followed for its plugin, at most `LOG_HELD` chunks ahead of it."""

    def __init__(self, chunks: AsyncIterator[bytes]) -> None:
        """Followed from now."""
        self.queue: asyncio.Queue[bytes | None] = asyncio.Queue(LOG_HELD)
        self.ended: bool = False
        self.task: asyncio.Future[None] = asyncio.ensure_future(self._follow(chunks))

    def close(self) -> None:
        """Stops following: its stream closed."""
        self.task.cancel()

    async def _follow(self, chunks: AsyncIterator[bytes]) -> None:
        try:
            async for chunk in chunks:
                await self.queue.put(chunk)
        except Exception as e:  # only a view: the output is read apart
            log.warning("a pod's log stopped: %s", e)
        await self.queue.put(None)

    async def next(self) -> tuple[bytes, bool]:
        """What came since, at most `LOG_CHUNK` bytes, and whether the log has ended.

        It waits `LOG_WAIT` for some, then answers with none.
        """
        if self.ended:
            return b"", True
        try:
            chunk = await asyncio.wait_for(self.queue.get(), LOG_WAIT)
        except TimeoutError:
            return b"", False
        data = bytearray()
        while chunk is not None:
            data += chunk
            if len(data) >= LOG_CHUNK or self.queue.empty():
                break
            chunk = self.queue.get_nowait()
        if chunk is None:
            self.ended = True
        return bytes(data), self.ended


class KubernetesService:
    """The service: the cluster, its watches and the plugins' calls."""

    def __init__(self, cluster: Cluster) -> None:
        """Of `cluster`, connected at its start."""
        self.cluster: Cluster = cluster
        self.pods: Watched = Watched()
        self.jobs: Watched = Watched()
        self.logs: dict[str, LogTail] = {}
        # Which attempt follows which pods' logs: closed with its connection (agy's review: a
        # plugin gone left its log followed for ever).
        self.followed: dict[str, set[str]] = {}
        # One `submit` or `delete` of a Job at a time; a Job deleted is never created after.
        self.locks: dict[str, asyncio.Lock] = {}
        self.deleted: OrderedDict[str, None] = OrderedDict()
        self.tasks: set[asyncio.Future[None]] = set()
        self.context: ServiceContext | None = None

    def _keep(self, work: Awaitable[None]) -> None:
        task = asyncio.ensure_future(work)
        self.tasks.add(task)
        task.add_done_callback(self.tasks.discard)

    async def start(self, context: ServiceContext) -> None:
        """Connects and starts watching, before it says it is ready."""
        self.context = context
        await self.cluster.open()
        self._keep(self.pods.follow(self.cluster.watch("pods")))
        self._keep(self.jobs.follow(self.cluster.watch("jobs")))
        self._keep(self.gauges())
        await context.status("watching", f"namespace {self.cluster.namespace}")

    async def stop(self) -> None:
        """SIGTERM: its log streams and watches stopped, then its connections closed."""
        for tail in self.logs.values():
            tail.close()
        stopping = [tail.task for tail in self.logs.values()]
        for task in list(self.tasks):
            task.cancel()
            stopping.append(task)
        await asyncio.gather(*stopping, return_exceptions=True)
        self.logs.clear()
        await self.cluster.close()

    async def on_closed(self, attempt: ServiceAttempt) -> None:
        """An attempt's connection closed: the logs it followed are let go."""
        for pod in self.followed.pop(attempt.attempt_id, set()):
            tail = self.logs.pop(pod, None)
            if tail is not None:
                tail.close()

    def lock(self, job: str) -> asyncio.Lock:
        """Job `job`'s lock; those not held are forgotten past `REMEMBERED`."""
        if len(self.locks) > REMEMBERED:
            self.locks = {name: held for name, held in self.locks.items() if held.locked()}
        return self.locks.setdefault(job, asyncio.Lock())

    async def gauges(self) -> None:
        """The namespace's pods as gauges, told when they change.

        Every worker sees the same pods, so the panels combine them with `max`.
        """
        told: dict[str, float] = {}
        seen = -1
        while True:
            async with self.pods.changed:
                while self.pods.version == seen:
                    await self.pods.changed.wait()
                seen = self.pods.version
                phases: dict[str, float] = {}
                for pod in self.pods.objects.values():
                    phase = str(obj(pod.get("status")).get("phase", "Unknown"))
                    phases[phase] = phases.get(phase, 0) + 1
            now = {
                "pods_running": phases.get("Running", 0.0),
                "pods_pending": phases.get("Pending", 0.0),
            }
            now.update({f"pods:{phase}": count for phase, count in phases.items()})
            # A phase gone is told as 0 once.
            now.update({key: 0.0 for key in told if key.startswith("pods:") and key not in now})
            if self.context is None:
                continue
            for key, value in now.items():
                if told.get(key) == value:
                    continue
                if key.startswith("pods:"):
                    await self.context.metric("pods", value, phase=key.removeprefix("pods:"))
                else:
                    await self.context.metric(key, value)
                told[key] = value

    async def on_call(self, attempt: ServiceAttempt, method: str, args: object) -> object:
        """A plugin's call."""
        given = obj(args)
        if method == "submit":
            return await self.submit(given)
        if method == "started":
            return await self.started(str(given.get("job")))
        if method == "ended":
            return await self.ended(str(given.get("job")))
        if method == "logs":
            pod = str(given.get("pod"))
            self.followed.setdefault(attempt.attempt_id, set()).add(pod)
            return await self.log_chunk(pod)
        if method == "output":
            # Read whole, so capped (Grok's review: one huge line took the shared service past
            # its memory): one byte past the task's `max_output_size` says it is over.
            limit = min(int(str(given.get("max_output_size", MAX_OUTPUT_READ))), MAX_OUTPUT_READ)
            last = await self.cluster.last_line(str(given.get("pod")), limit + 1)
            if len(last.encode()) > limit:
                raise ValueError(f"the output line is over {limit} bytes")
            return decoded(last[len(OUTPUT_PREFIX) :]) if last.startswith(OUTPUT_PREFIX) else None
        if method == "delete":
            namespace = str(given.get("namespace") or self.cluster.namespace)
            job = str(given.get("job"))
            # After a `submit` in flight, and before any later one (agy's review: a stop during
            # `submit` deleted nothing, the Job created after).
            async with self.lock(job):
                self.deleted[job] = None
                while len(self.deleted) > REMEMBERED:
                    self.deleted.popitem(last=False)
                await self.cluster.delete_job(job, namespace)
                await self.cluster.delete_secret(secret_name(job), namespace)
            return {"deleted": job}
        raise ValueError(f"unknown method `{method}`")

    async def submit(self, given: Mapping[str, ExtensionJson]) -> object:
        """The task's Secret and Job.

        The Secret holds its secret variables (if any); made the Job's once the Job exists, it is
        deleted with it. A step failing undoes what it made (agy's review: a Secret, or a running
        Job, was left behind); a Job already deleted is never created.
        """
        job = str(given.get("job"))
        payload = checked(given.get("payload"))
        values = {str(k): str(v) for k, v in obj(given.get("secrets")).items()}
        async with self.lock(job):
            if job in self.deleted:
                raise PodFailedError("the Job was deleted before it was created")
            namespace = self.cluster.namespace
            if values:
                await self.cluster.create_secret(secret_name(job), values)
            try:
                uid = await self.cluster.create_job(manifest(job, payload, sorted(values)))
            except BaseException:
                if values:
                    with contextlib.suppress(Exception):
                        await self.cluster.delete_secret(secret_name(job), namespace)
                raise
            if values:
                try:
                    await self.cluster.own_secret(secret_name(job), job, uid)
                except BaseException:
                    with contextlib.suppress(Exception):
                        await self.cluster.delete_job(job, namespace)
                        await self.cluster.delete_secret(secret_name(job), namespace)
                    raise
        return {"job": job}

    async def started(self, job: str) -> object:
        """Its pod's name once it runs or has ended; a failure when it never will."""

        def found() -> str | None:
            if job in self.jobs.deleted:
                raise PodFailedError("the Job was deleted")
            for pod in job_pods(self.pods.objects, job):
                stuck(pod)
                if obj(pod.get("status")).get("phase") in ("Running", "Succeeded", "Failed"):
                    return str(obj(pod.get("metadata")).get("name"))
            if obj(self.jobs.objects.get(job, {}).get("status")).get("failed"):
                raise PodFailedError("the Job failed before its pod started")
            return None

        try:
            return {"pod": await self.watched(found)}
        except PodFailedError as e:
            return failure(e)

    async def ended(self, job: str) -> object:
        """Its end: succeeded, or its failure."""
        failed_at: list[float] = []

        def found() -> bool | None:
            if job in self.jobs.deleted:
                raise PodFailedError("the Job was deleted")
            status = obj(self.jobs.objects.get(job, {}).get("status"))
            if status.get("succeeded"):
                return True
            for pod in job_pods(self.pods.objects, job):
                stuck(pod)
                for container in items(obj(pod.get("status")).get("containerStatuses")):
                    ended = obj(obj(obj(container).get("state")).get("terminated"))
                    if status.get("failed") and ended:
                        reason, code = ended.get("reason", "Error"), ended.get("exitCode")
                        raise PodFailedError(f"the pod ended {reason} with exit code {code}")
            if status.get("failed"):
                # Its pod's reason may come a moment later, on the other watch (agy's review).
                if not failed_at:
                    failed_at.append(time.monotonic())
                if time.monotonic() - failed_at[0] >= FAILURE_DETAIL_SECONDS:
                    raise PodFailedError("the Job failed")
            return None

        try:
            await self.watched(found)
        except PodFailedError as e:
            return failure(e)
        return {"succeeded": True}

    async def watched[T](self, found: Callable[[], T | None]) -> T:
        """`found` against the pods and the Jobs, looked at again after each change of either."""
        seen = (-1, -1)
        while True:
            now = (self.pods.version, self.jobs.version)
            if now != seen:
                seen = now
                answer = found()
                if answer is not None:
                    return answer
            waits = [
                asyncio.ensure_future(self._changed(self.pods, seen[0])),
                asyncio.ensure_future(self._changed(self.jobs, seen[1])),
            ]
            try:
                # Looked at again each second as well: some answers wait on time, not a change.
                await asyncio.wait(waits, timeout=1.0, return_when=asyncio.FIRST_COMPLETED)
            finally:
                for wait in waits:
                    wait.cancel()
            seen = (-1, -1)

    @staticmethod
    async def _changed(watched: Watched, since: int) -> None:
        async with watched.changed:
            while watched.version == since:
                await watched.changed.wait()

    async def log_chunk(self, pod: str) -> object:
        """The pod's log since the last call, base64."""
        tail = self.logs.get(pod)
        if tail is None:
            tail = self.logs[pod] = LogTail(self.cluster.follow_logs(pod))
        data, ended = await tail.next()
        if ended:
            self.logs.pop(pod, None)
        return {"data": base64.b64encode(data).decode(), "eof": ended}


