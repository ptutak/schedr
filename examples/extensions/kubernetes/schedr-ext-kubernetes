class Ui:
    """The cluster's web UI the links go to: Headlamp, or the (archived) Kubernetes Dashboard."""

    def __init__(self, kind: str, address: str, cluster: str = "main") -> None:
        """`kind` is `headlamp` or `dashboard`; `cluster` the cluster's name in Headlamp."""
        self.kind: str = kind
        self.address: str = address.rstrip("/")
        self.cluster: str = cluster

    def page_url(self, kind: str, namespace: str, name: str) -> str:
        """The page of a Job or a pod (`kind` is `job` or `pod`)."""
        if self.kind == "headlamp":
            # Headlamp's routes: /c/<cluster>/<kind>s/<namespace>/<name>; in a cluster its
            # own is `main`.
            return f"{self.address}/c/{self.cluster}/{kind}s/{namespace}/{name}"
        return f"{self.address}/#/{kind}/{namespace}/{name}?namespace={namespace}"


async def secret_values(
    payload: Mapping[str, ExtensionJson], channel: ExtensionChannel
) -> dict[str, str]:
    """The task's declared secrets its variables name, read through the worker."""
    values: dict[str, str] = {}
    for variable, reference in obj(payload.get("secret_env")).items():
        path, _, key = str(reference).partition("#")
        values[str(variable)] = str(await channel.secret(path, key or None))
    return values


async def write_log(channel: ExtensionChannel, pod: str) -> None:
    """The pod's log into the attempt's as it comes, byte for byte (no line is too long).

    Only a view: the output is read once the pod ended, so a log that breaks loses lines of the
    log, never the result.
    """
    while True:
        chunk = obj(await channel.service.call("logs", {"pod": pod}))
        sys.stdout.buffer.write(base64.b64decode(str(chunk.get("data", ""))))
        sys.stdout.buffer.flush()
        if chunk.get("eof"):
            return


async def never_started(
    channel: ExtensionChannel, where: tuple[str, str], started: Mapping[str, ExtensionJson]
) -> None:
    """A pod that never started: its event told, the Job counted as failed; raises."""
    job, namespace = where
    waiting = started.get("waiting")
    # Told to the DAG's channels subscribed to EXTENSION_EVENT (M5.2i8).
    if isinstance(waiting, str):
        event = "image_pull_failed" if "Image" in waiting else "pod_stuck"
        await channel.notify(
            event,
            f"job {job}: {started['failed']}",
            {"job": job, "namespace": namespace, "reason": waiting},
        )
    # Counted as ended too (agy's review: started, it never ended on the page).
    await channel.metric("jobs_ended", 1, outcome="failed")
    await channel.status("failed", progress=1.0)
    raise PodFailedError(str(started["failed"]))


def make_run(namespace: str, ui: Ui | None) -> Run:
    """The attempt: a Job through the service, its log written, its end taken as the task's."""

    def link_to(kind: str, name: str) -> str | None:
        # The UI's page of a Job or a pod, when its address is given.
        return None if ui is None else ui.page_url(kind, namespace, name)

    async def run(request: ExtensionRequest, channel: ExtensionChannel) -> object:
        payload = checked(request.payload)
        job = job_name(request)
        secrets = await secret_values(payload, channel)
        service = channel.service
        # Registered before the Job exists: a worker lost right after creating it leaves a
        # handle its cleanup deletes the Job by.
        await channel.add_handle("job", {"name": job, "namespace": namespace})
        await channel.status("creating", f"job {job}", progress=0.0)
        try:
            await service.call("submit", {"job": job, "payload": payload, "secrets": secrets})
            created = time.monotonic()
            log.info("created job %s", job, extra={"namespace": namespace})
            await channel.metric("jobs_started", 1, namespace=namespace)
            await channel.metric("jobs_by_image", 1, image=str(payload["image"]))
            if (url := link_to("job", job)) is not None:
                await channel.link("Job", url)
            await channel.status("pending", "waiting for its pod", progress=0.1)
            started = obj(await service.call("started", {"job": job}))
            if "failed" in started:
                await never_started(channel, (job, namespace), started)
            pod = str(started["pod"])
            begun = time.monotonic()
            await channel.metric("start_seconds", begun - created)
            await channel.status("running", f"pod {pod}", progress=0.5)
            if (url := link_to("pod", pod)) is not None:
                await channel.link("Pod", url)
            await write_log(channel, pod)
            ended = obj(await service.call("ended", {"job": job}))
            if "failed" in ended:
                await channel.metric("jobs_ended", 1, outcome="failed")
                await channel.status("failed", progress=1.0)
                raise PodFailedError(str(ended["failed"]))
            # Its output read before it is told succeeded (agy's review: one that couldn't be read
            # failed the attempt after "succeeded").
            output = await service.call(
                "output", {"pod": pod, "max_output_size": request.max_output_size}
            )
            await channel.metric("job_seconds", time.monotonic() - begun)
            await channel.metric("jobs_ended", 1, outcome="succeeded")
            await channel.status("succeeded", progress=1.0)
            return output
        except asyncio.CancelledError:
            # SIGTERM (decision 513): asked why. A cancel, a timeout or a drain: the Job goes
            # with the attempt (a drained one runs again elsewhere). A lost master: left to the
            # cleanup, which runs from the handle wherever the attempt's cleanup goes.
            reason, left = await channel.stop_reason()
            log.warning("stopped: %s", reason, extra={"grace_seconds": round(left, 1)})
            if reason != "master_lost":
                await service.call("delete", {"job": job, "namespace": namespace})
                log.info("deleted job %s", job)
            await channel.metric("jobs_ended", 1, outcome="stopped")
            raise

    return run


async def cleanup(request: ExtensionRequest, channel: ExtensionChannel) -> ExtensionJson:
    """After each attempt: its Job deleted, whatever its end (a lost worker's too).

    In the namespace the attempt created it in, which this worker's may not be.
    """
    deleted: list[ExtensionJson] = []
    for handle in request.handles:
        value = obj(handle.value)
        name, namespace = value.get("name"), value.get("namespace")
        if handle.type == "job" and isinstance(name, str):
            await channel.service.call("delete", {"job": name, "namespace": namespace})
            print(f"deleted job {name} in {namespace}", flush=True)
            deleted.append(name)
    return {"deleted": deleted}


