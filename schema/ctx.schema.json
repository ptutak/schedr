{
  "$defs": {
    "CleanupHandle": {
      "additionalProperties": false,
      "description": "A handle registered by an attempt: what its cleanup needs that only existed in it.",
      "properties": {
        "handle_type": {
          "description": "Its type's name (a dataclass's name, or `schedr task-ctx cleanup add`'s first argument).",
          "type": "string"
        },
        "value": {
          "description": "Its fields, as stored JSON."
        }
      },
      "required": [
        "handle_type",
        "value"
      ],
      "type": "object"
    },
    "CtxAnswer": {
      "description": "The agent's answer to a [`CtxRequest`].",
      "oneOf": [
        {
          "description": "The handshake succeeded.",
          "properties": {
            "type": {
              "const": "welcome",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The handshake failed (another protocol); the agent closes the connection.",
          "properties": {
            "reason": {
              "description": "Why.",
              "type": "string"
            },
            "type": {
              "const": "refused",
              "type": "string"
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The run's parameters, as stored (tagged, decision 138); `{}` when the DAG takes none.",
          "properties": {
            "params": {
              "additionalProperties": true,
              "description": "The values.",
              "type": "object"
            },
            "type": {
              "const": "params",
              "type": "string"
            }
          },
          "required": [
            "type",
            "params"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/CtxRun",
          "description": "The run information.",
          "properties": {
            "type": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The value of the secret asked for: a key's value as a string, a whole secret as an\nobject of key to value.",
          "properties": {
            "type": {
              "const": "secret",
              "type": "string"
            },
            "value": {
              "description": "The value."
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "Why the secret asked for can't be read; the connection stays open.",
          "properties": {
            "kind": {
              "description": "The error kind (`secret_unavailable`, `secret_denied`, `secret_not_found`).",
              "type": "string"
            },
            "reason": {
              "description": "What went wrong, naming the secret (never a value).",
              "type": "string"
            },
            "type": {
              "const": "secret_failed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The handle is registered.",
          "properties": {
            "type": {
              "const": "handle_added",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Why the handle isn't registered; the connection stays open.",
          "properties": {
            "reason": {
              "description": "What went wrong.",
              "type": "string"
            },
            "type": {
              "const": "handle_refused",
              "type": "string"
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The attempt's handles, in registration order.",
          "properties": {
            "handles": {
              "description": "The handles.",
              "items": {
                "$ref": "#/$defs/CleanupHandle"
              },
              "type": "array"
            },
            "type": {
              "const": "handles",
              "type": "string"
            }
          },
          "required": [
            "type",
            "handles"
          ],
          "type": "object"
        },
        {
          "description": "The resource's value is reported.",
          "properties": {
            "type": {
              "const": "resource_reported",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The resource's value, as stored JSON (tagged).",
          "properties": {
            "type": {
              "const": "resource",
              "type": "string"
            },
            "value": {
              "description": "The value."
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "Why the resource's value can't be reported or read; the connection stays open.",
          "properties": {
            "reason": {
              "description": "What went wrong (never the value).",
              "type": "string"
            },
            "type": {
              "const": "resource_refused",
              "type": "string"
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The values of the connection asked for, by parameter, as stored JSON (tagged).",
          "properties": {
            "type": {
              "const": "connection",
              "type": "string"
            },
            "values": {
              "additionalProperties": true,
              "description": "The values.",
              "type": "object"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "description": "The variables of the connection asked for, by name (`DB_URL`), its files written.",
          "properties": {
            "type": {
              "const": "connection_env",
              "type": "string"
            },
            "variables": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "The variables.",
              "type": "object"
            }
          },
          "required": [
            "type",
            "variables"
          ],
          "type": "object"
        },
        {
          "description": "Why the connection asked for can't be opened; the connection stays open.",
          "properties": {
            "kind": {
              "description": "The error kind (`connection_not_found`, `render_failed`, or a secret's).",
              "type": "string"
            },
            "reason": {
              "description": "What went wrong, naming the connection (never a value).",
              "type": "string"
            },
            "type": {
              "const": "connection_failed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "A request the agent can't answer (one it doesn't know, out of order); the connection\nis closed after it.",
          "properties": {
            "reason": {
              "description": "Why.",
              "type": "string"
            },
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "CtxRequest": {
      "description": "A request from a process of the task to the agent.",
      "oneOf": [
        {
          "description": "The first message: the protocol the caller speaks ([`CTX_PROTOCOL`]), which must be\nthe agent's, and its schedr version (for the messages).",
          "properties": {
            "protocol": {
              "description": "The protocol.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "schedr_version": {
              "description": "The `schedr` binary's or Python package's version.",
              "type": "string"
            },
            "type": {
              "const": "hello",
              "type": "string"
            }
          },
          "required": [
            "type",
            "protocol",
            "schedr_version"
          ],
          "type": "object"
        },
        {
          "description": "The run's parameters.",
          "properties": {
            "type": {
              "const": "params_get",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The run information.",
          "properties": {
            "type": {
              "const": "run_get",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A secret the task declares (`secrets=`), or one under a declared prefix.",
          "properties": {
            "secret": {
              "$ref": "#/$defs/SecretName",
              "description": "Which secret."
            },
            "type": {
              "const": "secret_get",
              "type": "string"
            }
          },
          "required": [
            "type",
            "secret"
          ],
          "type": "object"
        },
        {
          "description": "Registers a cleanup handle (`schedr task-ctx cleanup add`).",
          "properties": {
            "handle": {
              "$ref": "#/$defs/CleanupHandle",
              "description": "The handle."
            },
            "type": {
              "const": "handle_add",
              "type": "string"
            }
          },
          "required": [
            "type",
            "handle"
          ],
          "type": "object"
        },
        {
          "description": "The attempt's handles, in registration order (`schedr task-ctx cleanup list`).",
          "properties": {
            "type": {
              "const": "handle_list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A connection's values, rendered (decision 174): any connection of the task's root.",
          "properties": {
            "name": {
              "description": "The connection's name.",
              "type": "string"
            },
            "type": {
              "const": "connection_get",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "A connection as a command gets it (decisions 184, 190): its files written in the\nattempt's folder, and its variables (`task-ctx connection NAME --env PREFIX`).",
          "properties": {
            "name": {
              "description": "The connection's name.",
              "type": "string"
            },
            "prefix": {
              "description": "The variables' prefix (`DB` gives `DB_URL`).",
              "type": "string"
            },
            "type": {
              "const": "connection_env_get",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name",
            "prefix"
          ],
          "type": "object"
        },
        {
          "description": "Reports the value of the resource a `CommandResource` setup creates (`schedr task-ctx\nresource set`), as JSON; checked against its declared type at once.",
          "properties": {
            "type": {
              "const": "resource_set",
              "type": "string"
            },
            "value": {
              "description": "The value."
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "The value of the resource a command cleanup cleans up (`schedr task-ctx resource get`).",
          "properties": {
            "type": {
              "const": "resource_get",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "CtxRun": {
      "description": "The run information a task's processes can read (`schedr dag-ctx run get`).",
      "properties": {
        "dag_id": {
          "description": "The DAG's ID.",
          "type": "string"
        },
        "id": {
          "description": "The run's ID (a `UUIDv7`).",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RunKind",
          "description": "The run's kind."
        },
        "planned_for": {
          "description": "The moment the run is for.",
          "format": "date-time",
          "type": "string"
        },
        "since": {
          "description": "The start of the run's window.",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "dag_id",
        "id",
        "kind",
        "planned_for",
        "since"
      ],
      "type": "object"
    },
    "RunKind": {
      "description": "Who or what created a run.",
      "oneOf": [
        {
          "const": "scheduled",
          "description": "Created by the scheduler for a fire time.",
          "type": "string"
        },
        {
          "const": "manual",
          "description": "Started by a person (UI, CLI, API).",
          "type": "string"
        },
        {
          "const": "backfill",
          "description": "One of the runs of a backfill.",
          "type": "string"
        },
        {
          "const": "chained",
          "description": "Created by another DAG's run (`TriggerDagOperator`).",
          "type": "string"
        },
        {
          "const": "event",
          "description": "Created by an event from the DAG's trigger (an event trigger).",
          "type": "string"
        }
      ]
    },
    "SecretName": {
      "additionalProperties": false,
      "description": "A secret in a storage: `path#key`, or `path` for the whole secret.",
      "properties": {
        "default": {
          "description": "What a reference reads when the secret or its key is missing\n(`secrets['etl/db'].get('password', '')`); a key's only, never declared in `secrets=`.",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "The key in the secret (`password`); none for the whole secret, an object of key to\nvalue.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "The secret's path in the storage (`etl/db`).",
          "type": "string"
        },
        "storage": {
          "description": "The storage it comes from; none for the default one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/CtxRequest",
      "description": "From the task's process."
    },
    {
      "$ref": "#/$defs/CtxAnswer",
      "description": "From the agent."
    }
  ],
  "description": "Any message on a context connection (only used to generate one schema for both).",
  "title": "CtxChannelMessage"
}
