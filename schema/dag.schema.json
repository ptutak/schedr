{
  "$defs": {
    "CommandLine": {
      "description": "What a `command` task runs.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A string run by a shell; interpolated values are shell-quoted unless `raw`.",
          "properties": {
            "shell": {
              "$ref": "#/$defs/Template"
            }
          },
          "required": [
            "shell"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A program and its arguments, run without a shell; each element is one argument.",
          "properties": {
            "argv": {
              "items": {
                "$ref": "#/$defs/Template"
              },
              "type": "array"
            }
          },
          "required": [
            "argv"
          ],
          "type": "object"
        }
      ]
    },
    "DagCtxField": {
      "description": "A field of the run's context, `dag_ctx.run.*` and `dag_ctx.dag_id`.",
      "oneOf": [
        {
          "const": "run_id",
          "description": "`dag_ctx.run.id`.",
          "type": "string"
        },
        {
          "const": "run_kind",
          "description": "`dag_ctx.run.kind`.",
          "type": "string"
        },
        {
          "const": "planned_for",
          "description": "`dag_ctx.run.planned_for`.",
          "type": "string"
        },
        {
          "const": "since",
          "description": "`dag_ctx.run.since`.",
          "type": "string"
        },
        {
          "const": "dag_id",
          "description": "`dag_ctx.dag_id`.",
          "type": "string"
        }
      ]
    },
    "DagId": {
      "maxLength": 250,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:/#-]+$",
      "type": "string"
    },
    "DagLocation": {
      "additionalProperties": false,
      "description": "Where a DAG is defined: a DAG root and a file path relative to it.",
      "properties": {
        "path": {
          "description": "The file's path relative to the root, with `/` separators.",
          "type": "string"
        },
        "root": {
          "description": "The root's name (see PROJECT.md, DAG roots).",
          "type": "string"
        }
      },
      "required": [
        "root",
        "path"
      ],
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "A dependency: `to` runs after `from`, when `from` ended with one of the outcomes `on`.",
      "properties": {
        "from": {
          "$ref": "#/$defs/TaskId",
          "description": "The upstream task."
        },
        "kind": {
          "$ref": "#/$defs/EdgeKind",
          "description": "Why the dependency exists."
        },
        "on": {
          "description": "The upstream outcomes the edge is taken on (`.on(...)`); empty for any outcome. An edge\nnot taken counts as skipped in the downstream task's trigger rule.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "to": {
          "$ref": "#/$defs/TaskId",
          "description": "The downstream task."
        }
      },
      "required": [
        "from",
        "to",
        "kind"
      ],
      "type": "object"
    },
    "EdgeKind": {
      "description": "Why one task depends on another.",
      "oneOf": [
        {
          "const": "data",
          "description": "The downstream task takes the upstream task's output (or a part of it).",
          "type": "string"
        },
        {
          "const": "order",
          "description": "An order-only dependency (`>>`), no data passed.",
          "type": "string"
        }
      ]
    },
    "Field": {
      "additionalProperties": false,
      "description": "A named field of a `TypedDict` or dataclass.",
      "properties": {
        "name": {
          "description": "The field or key name.",
          "type": "string"
        },
        "required": {
          "description": "Whether the field must be present (`TypedDict`) or has no default (dataclass).",
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/TypeDesc",
          "description": "The field's type."
        }
      },
      "required": [
        "name",
        "type",
        "required"
      ],
      "type": "object"
    },
    "OutcomeDecl": {
      "additionalProperties": false,
      "description": "One of a task's outcomes: its name, and for a `command` task the exit code meaning it.",
      "properties": {
        "exit_code": {
          "description": "A `command` task's exit code for it; none for other tasks.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "The name (an `Outcome` enum member's, a class's, or `None`).",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "PathElem": {
      "anyOf": [
        {
          "description": "A dataclass field or dictionary key.",
          "type": "string"
        },
        {
          "description": "A list or tuple index.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      ],
      "description": "One step of a path into an output: a field or key, or a list / tuple index."
    },
    "Reference": {
      "description": "A reference to data known only at run time.",
      "oneOf": [
        {
          "description": "An upstream task's output, or a part of it.",
          "properties": {
            "kind": {
              "const": "output",
              "type": "string"
            },
            "on": {
              "description": "The outcomes it was narrowed to (`.on(...)`); empty for any. On another outcome,\nor a skipped upstream task, it stands for `null`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "path": {
              "description": "The path into the output; empty for the whole output.",
              "items": {
                "$ref": "#/$defs/PathElem"
              },
              "type": "array"
            },
            "task": {
              "$ref": "#/$defs/TaskId",
              "description": "The upstream task."
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "An upstream task's outcome itself (`.outcome`), as its name.",
          "properties": {
            "kind": {
              "const": "outcome",
              "type": "string"
            },
            "task": {
              "$ref": "#/$defs/TaskId",
              "description": "The upstream task."
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "A field of the run's context.",
          "properties": {
            "field": {
              "$ref": "#/$defs/DagCtxField",
              "description": "Which field."
            },
            "kind": {
              "const": "dag_ctx",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "field"
          ],
          "type": "object"
        }
      ]
    },
    "RunIf": {
      "description": "A task's trigger rule: what its upstream edges must have done for it to run (see\nPROJECT.md, Outcomes, failures and joins). An edge not taken counts as skipped.",
      "oneOf": [
        {
          "const": "none_failed",
          "description": "Every edge that wasn't skipped succeeded, and at least one did: skipped when all were\nskipped, `upstream_failed` when one failed.",
          "type": "string"
        },
        {
          "const": "all_succeeded",
          "description": "Every edge succeeded: `upstream_failed` when one failed, otherwise skipped when one\nwas skipped.",
          "type": "string"
        }
      ]
    },
    "SchedrVersion": {
      "description": "A schedr version as `major.minor`.",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "Task": {
      "description": "A task of a DAG.",
      "oneOf": [
        {
          "description": "A `@task` function, found by task ID when the runner imports the DAG file.",
          "properties": {
            "arguments": {
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              },
              "default": {},
              "description": "The arguments by parameter name.",
              "type": "object"
            },
            "kind": {
              "const": "python",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "An inline command, run by the agent.",
          "properties": {
            "command": {
              "$ref": "#/$defs/CommandLine",
              "description": "The command line."
            },
            "env": {
              "additionalProperties": {
                "$ref": "#/$defs/Template"
              },
              "description": "Extra environment variables for the process.",
              "type": "object"
            },
            "kind": {
              "const": "command",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "command"
          ],
          "type": "object"
        },
        {
          "description": "An `EmptyOperator`: completed by the master, no process.",
          "properties": {
            "kind": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/TaskId",
          "description": "The task's ID, unique within its DAG."
        },
        "outcomes": {
          "description": "The outcomes it may end with (see PROJECT.md, Task results and outcomes).",
          "items": {
            "$ref": "#/$defs/OutcomeDecl"
          },
          "type": "array"
        },
        "output_type": {
          "$ref": "#/$defs/TypeDesc",
          "description": "The type of its output (`process_result` for commands, `none` for empty tasks)."
        },
        "settings": {
          "$ref": "#/$defs/TaskSettings",
          "description": "Its resolved settings."
        }
      },
      "required": [
        "id",
        "settings",
        "output_type"
      ],
      "type": "object"
    },
    "TaskId": {
      "maxLength": 250,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
      "type": "string"
    },
    "TaskSettings": {
      "additionalProperties": false,
      "description": "A task's settings, resolved from its own arguments and the defaults that apply to it.",
      "properties": {
        "fresh_process": {
          "default": false,
          "description": "A Python task: always a new process, never forked (for code that misbehaves after a\nfork). Not for other tasks.",
          "type": "boolean"
        },
        "max_output_size": {
          "description": "The output size limit in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "preload": {
          "default": true,
          "description": "A Python task: fork it from the preloaded fork server (`false`: only from the bare\none, for code that misbehaves next to the preloaded libraries). Not for other tasks.",
          "type": "boolean"
        },
        "queue": {
          "description": "The queue the task goes to.",
          "type": "string"
        },
        "retries": {
          "description": "How many times a failed attempt is retried.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "retry_delay_ms": {
          "description": "The delay before each retry, in milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run_if": {
          "$ref": "#/$defs/RunIf",
          "description": "When it runs, from its upstream edges (its trigger rule)."
        },
        "timeout_ms": {
          "description": "The attempt's timeout in milliseconds; `None` for no timeout.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "retries",
        "retry_delay_ms",
        "queue",
        "max_output_size"
      ],
      "type": "object"
    },
    "Template": {
      "description": "A t-string as data: its parts in order.",
      "items": {
        "$ref": "#/$defs/TemplatePart"
      },
      "type": "array"
    },
    "TemplatePart": {
      "description": "One part of a template: literal text, or a reference filled in at run time.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Literal text.",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A reference, rendered at run time.",
          "properties": {
            "ref": {
              "$ref": "#/$defs/TemplateRef"
            }
          },
          "required": [
            "ref"
          ],
          "type": "object"
        }
      ]
    },
    "TemplateRef": {
      "description": "A reference inside a template, with its optional format spec (e.g. `raw`, `%Y-%m-%d`).",
      "oneOf": [
        {
          "description": "An upstream task's output, or a part of it.",
          "properties": {
            "kind": {
              "const": "output",
              "type": "string"
            },
            "on": {
              "description": "The outcomes it was narrowed to (`.on(...)`); empty for any. On another outcome,\nor a skipped upstream task, it stands for `null`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "path": {
              "description": "The path into the output; empty for the whole output.",
              "items": {
                "$ref": "#/$defs/PathElem"
              },
              "type": "array"
            },
            "task": {
              "$ref": "#/$defs/TaskId",
              "description": "The upstream task."
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "An upstream task's outcome itself (`.outcome`), as its name.",
          "properties": {
            "kind": {
              "const": "outcome",
              "type": "string"
            },
            "task": {
              "$ref": "#/$defs/TaskId",
              "description": "The upstream task."
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "type": "object"
        },
        {
          "description": "A field of the run's context.",
          "properties": {
            "field": {
              "$ref": "#/$defs/DagCtxField",
              "description": "Which field."
            },
            "kind": {
              "const": "dag_ctx",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "field"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "format": {
          "description": "The t-string format spec, if any.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Trigger": {
      "description": "What starts runs of a DAG besides people (and other DAGs).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Nothing: manual runs only.",
          "properties": {
            "kind": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A cron expression (5 or 6 fields, or a preset such as `@daily`) evaluated in a time zone.",
          "properties": {
            "catchup": {
              "description": "Whether missed fire times get runs in order (`true`) or only the most recent\n(`false`).",
              "type": "boolean"
            },
            "end": {
              "default": null,
              "description": "The last run it creates is for the last fire time at or before it.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "expression": {
              "description": "The cron expression.",
              "type": "string"
            },
            "kind": {
              "const": "cron",
              "type": "string"
            },
            "start": {
              "default": null,
              "description": "The first run it creates is for the first fire time at or after it; without it,\nthe moment the master first stored the DAG.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "timezone": {
              "description": "An IANA time zone name, e.g. `Europe/Warsaw`; `UTC` by default in the Python API.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "expression",
            "timezone",
            "catchup"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A fixed interval measured in real time (UTC), unaffected by daylight saving.",
          "properties": {
            "catchup": {
              "description": "Whether missed fire times get runs in order (`true`) or only the most recent\n(`false`).",
              "type": "boolean"
            },
            "end": {
              "default": null,
              "description": "The last run it creates is for the last fire time at or before it.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "interval_ms": {
              "description": "The interval in milliseconds; fire times are whole intervals from `start`, or from\nthe Unix epoch without one.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "every",
              "type": "string"
            },
            "start": {
              "default": null,
              "description": "The first run it creates is for the first fire time at or after it; without it,\nthe moment the master first stored the DAG.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "interval_ms",
            "catchup"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A single fire time (it has no previous fire time).",
          "properties": {
            "at": {
              "description": "The fire time.",
              "format": "date-time",
              "type": "string"
            },
            "kind": {
              "const": "once",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at"
          ],
          "type": "object"
        }
      ]
    },
    "TypeDesc": {
      "description": "The type of a value that can be stored as a task output.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Anything (an explicit `Any`): only the run-time check applies.",
          "properties": {
            "type": {
              "const": "any",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`None`.",
          "properties": {
            "type": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`bool`.",
          "properties": {
            "type": {
              "const": "bool",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`int`.",
          "properties": {
            "type": {
              "const": "int",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`float`.",
          "properties": {
            "type": {
              "const": "float",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`str`.",
          "properties": {
            "type": {
              "const": "str",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`datetime` (stored tagged).",
          "properties": {
            "type": {
              "const": "datetime",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`date` (stored tagged).",
          "properties": {
            "type": {
              "const": "date",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`timedelta` (stored tagged).",
          "properties": {
            "type": {
              "const": "timedelta",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`list[T]`.",
          "properties": {
            "item": {
              "$ref": "#/$defs/TypeDesc",
              "description": "The element type."
            },
            "type": {
              "const": "list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`tuple[A, B, ...]` (stored tagged).",
          "properties": {
            "items": {
              "description": "The element types, in order.",
              "items": {
                "$ref": "#/$defs/TypeDesc"
              },
              "type": "array"
            },
            "type": {
              "const": "tuple",
              "type": "string"
            }
          },
          "required": [
            "type",
            "items"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`dict[str, T]` (keys are always strings).",
          "properties": {
            "type": {
              "const": "dict",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/TypeDesc",
              "description": "The value type."
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`Literal[...]`.",
          "properties": {
            "type": {
              "const": "literal",
              "type": "string"
            },
            "values": {
              "description": "The allowed values (strings, integers, booleans or `null`).",
              "items": true,
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A union, including `Optional[T]` (`T | None`).",
          "properties": {
            "type": {
              "const": "union",
              "type": "string"
            },
            "variants": {
              "description": "The member types.",
              "items": {
                "$ref": "#/$defs/TypeDesc"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "variants"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A `TypedDict`.",
          "properties": {
            "fields": {
              "description": "The keys, in declaration order.",
              "items": {
                "$ref": "#/$defs/Field"
              },
              "type": "array"
            },
            "name": {
              "description": "The class name, for messages.",
              "type": "string"
            },
            "type": {
              "const": "typed_dict",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name",
            "fields"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A dataclass.",
          "properties": {
            "fields": {
              "description": "The fields, in declaration order.",
              "items": {
                "$ref": "#/$defs/Field"
              },
              "type": "array"
            },
            "name": {
              "description": "The class name, for messages and outcome names.",
              "type": "string"
            },
