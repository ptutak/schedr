#!/usr/bin/env python3
"""A dummy extension's plugin (decision 510): its payload says what to do, to see how one behaves.

The payload is a list of steps, done in order; the output is what the last ``return`` gives:

    {"sleep": 2}                       sleep two seconds
    {"log": "text"}                    print a line to the attempt's log
    {"secret": ["path", "key"]}        read a declared secret (its length is logged, never it)
    {"handle": {"id": "job-1"}}        register a cleanup handle of type ``job``
    {"status": ["phase", 0.5]}         report a status (its phase, how far along), shown on the task
    {"link": ["Pod", "https://..."]}   report a link, shown on the task
    {"metric": ["steps", 1, {"step": "log"}]}  report a point of a declared metric (below)
    {"notify": ["job_done", "text", {...}]}    send a declared notification event (below)
    {"return": {"rows": 3}}            the task's output
    {"fail": "why"}                    fail the attempt
    {"hang": true}                     wait until stopped, then print why (``stop_reason``)
    {"simulate": 5}                    five rounds of made-up work, each reported in every metric
                                       below and logged as a structured line: what fills its page

Its own lines go through ``logging``, structured (decision 514): the Logs tab shows their level.

Configure it on a worker as ``[extensions.dummy] command = ["/path/to/schedr-ext-dummy"]`` and
``versions = ["1.0"]``, or put it on ``PATH`` with ``[extensions] discover = true``.
"""

import asyncio
import logging
import random
from collections.abc import Awaitable, Callable

from schedr.extension import (
    ExtensionChannel,
    ExtensionJson,
    ExtensionRequest,
    MetricDeclaration,
    NotificationDeclaration,
    PanelDeclaration,
    main,
)
from schedr.types import Json


def _parts(value: ExtensionJson, count: int, step: str) -> list[ExtensionJson]:
    """A step's value as the list of `count` parts it takes."""
    if not isinstance(value, list) or len(value) != count:
        raise ValueError(f"`{step}` takes a list of {count}, got {value!r}")
    return value


def _text(value: ExtensionJson, step: str) -> str:
    if not isinstance(value, str):
        raise ValueError(f"`{step}` takes text, got {value!r}")
    return value


def _number(value: ExtensionJson, step: str) -> float:
    if isinstance(value, bool) or not isinstance(value, int | float | str):
        raise ValueError(f"`{step}` takes a number, got {value!r}")
    try:
        return float(value)
    except ValueError:
        raise ValueError(f"`{step}` takes a number, got {value!r}") from None


async def _secret(channel: ExtensionChannel, value: ExtensionJson) -> None:
    path, key = _parts(value, 2, "secret")
    # A null key reads the whole secret (agy's review of M5.2i7: refused once typed).
    path, key = _text(path, "secret"), None if key is None else _text(key, "secret")
    secret = await channel.secret(path, key)
    print(f"secret {path}#{key}: {len(str(secret))} characters", flush=True)


async def _handle(channel: ExtensionChannel, value: ExtensionJson) -> None:
    await channel.add_handle("job", value)
    print(f"handle registered: {value}", flush=True)


async def _status(channel: ExtensionChannel, value: ExtensionJson) -> None:
    phase, progress = _parts(value, 2, "status")
    # A status without a progress: null.
    fraction = None if progress is None else _number(progress, "status")
    await channel.status(_text(phase, "status"), progress=fraction)


async def _link(channel: ExtensionChannel, value: ExtensionJson) -> None:
    label, url = _parts(value, 2, "link")
    await channel.link(_text(label, "link"), _text(url, "link"))


async def _metric(channel: ExtensionChannel, value: ExtensionJson) -> None:
    name, number, labels = _parts(value, 3, "metric")
    if not isinstance(labels, dict):
        raise ValueError(f"`metric` takes its labels as an object, got {labels!r}")
    named = {key: _text(text, "metric") for key, text in labels.items()}
    await channel.metric(_text(name, "metric"), _number(number, "metric"), **named)


async def _notify(channel: ExtensionChannel, value: ExtensionJson) -> None:
    event, text, data = _parts(value, 3, "notify")
    said = None if text is None else _text(text, "notify")
    await channel.notify(_text(event, "notify"), said, data)


async def _hang(channel: ExtensionChannel, value: ExtensionJson) -> None:
    del value
    try:
        await asyncio.Event().wait()
    except asyncio.CancelledError:
        # Stopped (SIGTERM): why, and how long until SIGKILL (decision 513).
        reason, left = await channel.stop_reason()
        print(f"stopped: {reason}, {left:.0f} s left", flush=True)
        raise


async def _sleep(channel: ExtensionChannel, value: ExtensionJson) -> None:
    del channel
    await asyncio.sleep(_number(value, "sleep"))


async def _log(channel: ExtensionChannel, value: ExtensionJson) -> None:
    del channel
    print(value, flush=True)


REGIONS = ("eu", "us", "asia")
log = logging.getLogger("schedr-ext-dummy")


async def _simulate(channel: ExtensionChannel, value: ExtensionJson) -> None:
    """`value` rounds of made-up jobs: each round's queues, a job slept, its outcome."""
    rounds = int(_number(value, "simulate"))
    for i in range(rounds):
        await channel.status("simulating", f"round {i + 1} of {rounds}", progress=i / rounds)
        for region in REGIONS:
            await channel.metric("queue_depth", float(random.randint(0, 40)), region=region)
        await channel.metric("in_flight", float(random.randint(1, 8)))
        took = min(random.lognormvariate(-0.7, 0.8), 3.0)
        await asyncio.sleep(took)
        await channel.metric("sleep_seconds", took)
        await channel.metric("bytes_read", float(random.randint(10_000, 5_000_000)))
        outcome = random.choices(["succeeded", "retried", "failed"], [8, 2, 1])[0]
        await channel.metric("jobs", 1, outcome=outcome)
        level = {"succeeded": logging.INFO, "retried": logging.WARNING}.get(outcome, logging.ERROR)
        log.log(level, "job %s", outcome, extra={"round": i + 1, "seconds": round(took, 3)})
    await channel.metric("in_flight", 0.0)
    await channel.status("done", f"{rounds} rounds", progress=1.0)


async def _fail(channel: ExtensionChannel, value: ExtensionJson) -> None:
    del channel
    raise RuntimeError(str(value))


STEPS: dict[str, Callable[[ExtensionChannel, ExtensionJson], Awaitable[None]]] = {
    "sleep": _sleep,
    "log": _log,
    "secret": _secret,
    "handle": _handle,
    "status": _status,
    "link": _link,
    "metric": _metric,
    "notify": _notify,
    "fail": _fail,
    "hang": _hang,
    "simulate": _simulate,
}


async def run(request: ExtensionRequest, channel: ExtensionChannel) -> Json:
    """Does the payload's steps."""
    output: Json = None
    steps = request.payload if isinstance(request.payload, list) else [request.payload]
    for step in steps:
        if not isinstance(step, dict) or len(step) != 1:
            raise ValueError(f"a step is an object of one key, got {step!r}")
        ((what, value),) = step.items()
        if what == "return":
            output = value
        elif what in STEPS:
            await STEPS[what](channel, value)
        else:
            raise ValueError(f"unknown step `{what}`")
    return output


async def cleanup(request: ExtensionRequest, channel: ExtensionChannel) -> Json:
    """Prints the handles it was given: what a real cleanup would undo."""
    del channel
    for handle in request.handles:
        print(f"cleaning up {handle.type}: {handle.value}", flush=True)
    return None


# Its metrics (decision 513), declared in its hello. `simulate` reports all of them.
METRICS: list[MetricDeclaration] = [
    {
        "name": "steps",
        "kind": "counter",
        "help": "Steps done, by step",
        "labels": [{"name": "step"}],
    },
    {
        "name": "sleep_seconds",
        "kind": "histogram",
        "help": "How long a sleep step slept",
        "unit": "seconds",
        "buckets": [0.1, 0.25, 0.5, 1, 2, 5, 10],
    },
    {
        "name": "jobs",
        "kind": "counter",
        "help": "Made-up jobs ended, by outcome",
        "labels": [{"name": "outcome", "values": ["succeeded", "retried", "failed"]}],
