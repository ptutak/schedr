log = logging.getLogger("schedr-ext-kubernetes")


async def running_pods(kubectl: Kubectl, channel: ExtensionChannel) -> None:
    """The gauge: schedr's pods running in the namespace now, as the cluster says."""
    with contextlib.suppress(RuntimeError, ValueError):
        pods = await kubectl.json(
            "get",
            "pods",
            "-l",
            "app.kubernetes.io/managed-by=schedr",
            "--field-selector=status.phase=Running",
        )
        await channel.metric("pods_running", float(len(items(pods.get("items")))))


def make_run(kubectl: Kubectl, dashboard: str | None) -> Run:
    """The attempt: a Job created, its log streamed, its end taken as the task's."""

    def links_for(kind: str, name: str) -> str | None:
        # The Kubernetes Dashboard's page of a Job or a pod, when its address is given.
        if dashboard is None:
            return None
        ns = kubectl.namespace
        return f"{dashboard.rstrip('/')}/#/{kind}/{ns}/{name}?namespace={ns}"

    async def run(request: ExtensionRequest, channel: ExtensionChannel) -> object:
        payload = checked(request.payload)
        job = job_name(request)
        env = await environment(payload, channel)
        # Registered before the Job exists: a worker lost right after creating it leaves a
        # handle its cleanup deletes the Job by.
        await channel.add_handle("job", {"name": job, "namespace": kubectl.namespace})
        await channel.status("creating", f"job {job}", progress=0.0)
        try:
            await kubectl.run("create", "-f", "-", stdin=json.dumps(manifest(job, payload, env)))
            created = time.monotonic()
            log.info("created job %s", job, extra={"namespace": kubectl.namespace})
            await channel.metric("jobs_started", 1, namespace=kubectl.namespace)
            if (url := links_for("job", job)) is not None:
                await channel.link("Job", url)
            await channel.status("pending", "waiting for its pod", progress=0.1)
            pod = await started_pod(kubectl, job)
            started = time.monotonic()
            await channel.metric("start_seconds", started - created)
            await channel.status("running", f"pod {pod}", progress=0.5)
            if (url := links_for("pod", pod)) is not None:
                await channel.link("Pod", url)
            await running_pods(kubectl, channel)
            await stream_logs(kubectl, pod)
            try:
                await outcome(kubectl, job)
            except PodFailedError:
                await channel.metric("jobs_ended", 1, outcome="failed")
                await channel.status("failed", progress=1.0)
                raise
            await channel.metric("job_seconds", time.monotonic() - started)
            await channel.metric("jobs_ended", 1, outcome="succeeded")
            await channel.status("succeeded", progress=1.0)
            await running_pods(kubectl, channel)
            return await output(kubectl, pod)
        except asyncio.CancelledError:
            # SIGTERM (decision 513): asked why. A cancel, a timeout or a drain: the Job goes
            # with the attempt (a drained one runs again elsewhere). A lost master: left to the
            # cleanup, which runs from the handle wherever the attempt's cleanup goes.
            reason, left = await channel.stop_reason()
            log.warning("stopped: %s", reason, extra={"grace_seconds": round(left, 1)})
            if reason != "master_lost":
                kubectl.delete_now(job)
                log.info("deleted job %s", job)
            await channel.metric("jobs_ended", 1, outcome="stopped")
            raise

    return run


def make_cleanup(kubectl: Kubectl) -> Run:
    """After each attempt: its Job deleted, whatever its end (a lost worker's too)."""

    async def cleanup(request: ExtensionRequest, channel: ExtensionChannel) -> object:
        deleted = []
        for handle in request.handles:
            value = obj(handle.value)
            name, namespace = value.get("name"), value.get("namespace")
            if handle.type == "job" and isinstance(name, str):
                # In the namespace the attempt created it in, which this worker's may not be
                # (a cleanup moved to another worker).
                where = kubectl.in_namespace(namespace) if isinstance(namespace, str) else kubectl
                await where.run("delete", "job", name, "--ignore-not-found", "--wait=false")
                print(f"deleted job {name} in {where.namespace}", flush=True)
                deleted.append(name)
        return {"deleted": deleted}

    return cleanup


def entry(argv: list[str]) -> int:
    """Its options, then the helper's loop (`--describe` alone is the helper's)."""
    dashboard = None
    if argv == ["--describe"]:
        kubectl = Kubectl("default", None, None)
    else:
        parser = argparse.ArgumentParser(prog="schedr-ext-kubernetes")
        parser.add_argument("--namespace", default="default")
        parser.add_argument("--context")
        parser.add_argument("--kubeconfig")
        parser.add_argument("--dashboard", help="the Kubernetes Dashboard's address, for links")
        options = parser.parse_args(argv)
        kubectl = Kubectl(options.namespace, options.context, options.kubeconfig)
        dashboard = options.dashboard
        argv = []
    return main(
        make_run(kubectl, dashboard),
        name="kubernetes",
        versions=["1.0"],
        cleanup=make_cleanup(kubectl),
        metrics=METRICS,
        panels=PANELS,
        argv=argv,
    )


if __name__ == "__main__":
    raise SystemExit(entry(sys.argv[1:]))
