{
  "description": "Inputs and Python's shlex.quote results; checked by the Rust and Python unit tests so both quote identically.",
  "cases": [
    {
      "input": "",
      "quoted": "''"
    },
    {
      "input": "plain",
      "quoted": "plain"
    },
    {
      "input": "a b",
      "quoted": "'a b'"
    },
    {
      "input": "it's",
      "quoted": "'it'\"'\"'s'"
    },
    {
      "input": "x'y'z",
      "quoted": "'x'\"'\"'y'\"'\"'z'"
    },
    {
      "input": "$(rm -rf ~)",
      "quoted": "'$(rm -rf ~)'"
    },
    {
      "input": "a;b",
      "quoted": "'a;b'"
    },
    {
      "input": "a|b",
      "quoted": "'a|b'"
    },
    {
      "input": "a&b",
      "quoted": "'a&b'"
    },
    {
      "input": "back`tick`",
      "quoted": "'back`tick`'"
    },
    {
      "input": "new\nline",
      "quoted": "'new\nline'"
    },
    {
      "input": "tab\tx",
      "quoted": "'tab\tx'"
    },
    {
      "input": "https://x/a b;rm -rf ~",
      "quoted": "'https://x/a b;rm -rf ~'"
    },
    {
      "input": "--flag=value",
      "quoted": "--flag=value"
    },
    {
      "input": "a,b:c/d.e_f-g",
      "quoted": "a,b:c/d.e_f-g"
    },
    {
      "input": "@user%20+",
      "quoted": "@user%20+"
    },
    {
      "input": "ünïcödé",
      "quoted": "'ünïcödé'"
    },
    {
      "input": "日本",
      "quoted": "'日本'"
    },
    {
      "input": "\"double\"",
      "quoted": "'\"double\"'"
    },
    {
      "input": "*",
      "quoted": "'*'"
    },
    {
      "input": "?",
      "quoted": "'?'"
    },
    {
      "input": "~",
      "quoted": "'~'"
    },
    {
      "input": "#c",
      "quoted": "'#c'"
    },
    {
      "input": "a\\b",
      "quoted": "'a\\b'"
    },
    {
      "input": " ",
      "quoted": "' '"
    },
    {
      "input": "''",
      "quoted": "''\"'\"''\"'\"''"
    }
  ]
}
