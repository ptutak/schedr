    {
        "title": "Queue depth",
        "metric": "queue_depth",
        "chart": "line",
        "row": 3,
        "cell": "left",
        "colors": {"eu": "indigo", "us": "coral", "asia": "mint"},
        "combine": "max",
    },
    {
        "title": "Queues now",
        "metric": "queue_depth",
        "chart": "table",
        "row": 3,
        "cell": "right",
        "combine": "max",
    },
    {"title": "Events", "chart": "events", "row": 4, "cell": "full"},
]

# Its notification events (M5.2i8), declared in its hello: told to the channels of a DAG
# subscribed to `Notify.EXTENSION_EVENT`.
NOTIFICATIONS: list[NotificationDeclaration] = [
    {"name": "job_done", "help": "A made-up job ended"},
]

if __name__ == "__main__":
    raise SystemExit(
        main(
            run,
            name="dummy",
            versions=["1.0"],
            cleanup=cleanup,
            metrics=METRICS,
            panels=PANELS,
            notifications=NOTIFICATIONS,
        )
    )
